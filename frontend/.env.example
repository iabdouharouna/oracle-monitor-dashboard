# Frontend Environment Variables
# Copy to .env.local or .env for local development

# API Configuration
# In production (served by nginx), the default '/api/v1' is proxied to the backend.
# Only set an absolute URL when running outside the nginx reverse proxy (e.g. standalone local dev).
# VITE_API_URL=/api/v1
# VITE_WS_URL=ws://localhost:8000

# Application
VITE_APP_TITLE=Oracle Monitor Dashboard

# Feature Flags (optional)
# VITE_ENABLE_DIAGNOSTICS_PACK=true
# VITE_ENABLE_KILL_SESSION=false

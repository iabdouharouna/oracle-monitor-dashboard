# Databases
# No database is configured by default: enroll databases from the UI (Connections page).
# Databases are persisted in the backend config/ volume. If you prefer seeding them
# declaratively, provide a JSON list (entries seeded this way cannot be removed from the UI):
#DATABASES_JSON=[{"name":"FREE","host":"oradb-free","port":1521,"service":"freepdb1","username":"monitor","password":"secret"}]

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Features
HAS_DIAGNOSTICS_PACK=true
DEBUG=false
LOG_LEVEL=INFO

# Frontend (build time)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_APP_TITLE=Oracle Monitor Dashboard